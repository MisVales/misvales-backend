# Application
APP_NAME=MisVales
APP_ENV=local
AUTH_DEVELOPMENT_MFA_BYPASS=false
APP_DEBUG=true
RUNTIME_LOG_LEVEL=debug
RUNTIME_LOG_DAYS=14
RATELIMIT=true
APP_URL=http://192.168.1.106:8000
FRONTEND_URL=http://192.168.1.106:4200
VPN_FRONTEND_URL=http://192.168.1.106:4201
APP_TIMEZONE=America/Monterrey
DB_TIMEZONE=-06:00
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12
CLIENT_DATA_HMAC_KEY=
VPN_NETWORKS=192.168.50.0/24
TRUSTED_PROXIES=127.0.0.1,::1
INTERNAL_LOAD_BALANCER_PROXIES=10.124.0.0/16
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_SSL=true
TURNSTILE_CA_BUNDLE=

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
PERFORMANCE_LOG_LEVEL=warning
PERFORMANCE_LOG_DAYS=14

# Observabilidad operacional (deshabilitada por defecto en desarrollo local)
OBSERVABILITY_ENABLED=false
OBSERVABILITY_QUERY_METRICS_ENABLED=true
OBSERVABILITY_SLOW_QUERY_ENABLED=true
OBSERVABILITY_SLOW_QUERY_THRESHOLD_MS=250
OBSERVABILITY_SLOW_QUERY_CHANNEL=performance
OBSERVABILITY_EXPOSE_SERVER_TIMING=true

# MariaDB
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
DB_DATABASE=misvales
DB_USERNAME=
DB_PASSWORD=

# Optional Primary/Replica overrides (private VPC addresses)
MARIADB_PRIMARY_HOST=
MARIADB_PRIMARY_PORT=
DB_PRIMARY_USERNAME=
DB_PRIMARY_PASSWORD=
MARIADB_REPLICA_HOST=
MARIADB_REPLICA_PORT=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PRIMARY_SSL_CA=
DB_PRIMARY_SSL_CERT=
DB_PRIMARY_SSL_KEY=
DB_REPLICA_SSL_CA=
DB_REPLICA_SSL_CERT=
DB_REPLICA_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

# Filesystem
FILESYSTEM_DISK=local

# Cache
CACHE_STORE=redis
CACHE_PREFIX=misvales_local_cache_

# Sessions
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queues
# Las tareas y correos se ejecutan inmediatamente; no se conservan para reintento.
QUEUE_CONNECTION=sync

# Redis
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=misvales_local_

# Horizon
HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_local_horizon:
HORIZON_PATH=horizon
HORIZON_DEFAULT_MAX_PROCESSES=2
HORIZON_ALLOWED_EMAILS=

# Sanctum
SANCTUM_STATEFUL_DOMAINS=192.168.1.106,192.168.1.106:4200,192.168.1.106:4201,localhost,localhost:4200,localhost:4201,127.0.0.1,127.0.0.1:4200,127.0.0.1:4201

# CORS
CORS_ALLOWED_ORIGINS=http://192.168.1.106:4200,http://192.168.1.106:4201,http://localhost:4200,http://localhost:4201,http://127.0.0.1:4200,http://127.0.0.1:4201
CORS_MAX_AGE=0

# Google Maps Address Validation API
GOOGLE_MAPS_ADDRESS_VALIDATION_API_KEY=

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@misvales.local
MAIL_FROM_NAME="${APP_NAME}"

# External object storage placeholders
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Initial General Manager
INITIAL_MANAGER_NAME="Gerente General"
INITIAL_MANAGER_EMAIL="admin@misvales.com"
