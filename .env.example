# Application
APP_NAME=MisVales
APP_ENV=local
APP_DEBUG=true
RATELIMIT=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
APP_TIMEZONE=America/Monterrey
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=misvales
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Cache
CACHE_STORE=redis
CACHE_PREFIX=misvales_local_cache_

# Sessions
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queues
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5

# Redis
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=misvales_local_

# Horizon
HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_local_horizon:
HORIZON_PATH=horizon

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_MAX_AGE=0

# Google Maps Address Validation API
GOOGLE_MAPS_ADDRESS_VALIDATION_API_KEY=

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@misvales.local
MAIL_FROM_NAME="${APP_NAME}"

# External object storage placeholders
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Initial General Manager
INITIAL_MANAGER_NAME="Gerente General"
INITIAL_MANAGER_EMAIL="admin@misvales.com"
