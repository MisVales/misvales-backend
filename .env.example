# Application
APP_NAME=MisVales
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Monterrey
INITIAL_GENERAL_MANAGER_ENABLED=false
INITIAL_GENERAL_MANAGER_EMAIL=
INITIAL_GENERAL_MANAGER_NAME=
ACCESS_REVOCATION_CACHE_STORE=redis
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

# Access module (M01)
ACCESS_TOKEN_TTL_MINUTES=10
ACCESS_ADMIN_REFRESH_TTL_MINUTES=480
ACCESS_TABLET_REFRESH_TTL_MINUTES=480
ACCESS_DISTRIBUTOR_REFRESH_TTL_MINUTES=1440
ACCESS_ADMIN_IDLE_TIMEOUT_MINUTES=15
ACCESS_TABLET_IDLE_TIMEOUT_MINUTES=15
ACCESS_DISTRIBUTOR_IDLE_TIMEOUT_MINUTES=30
ACCESS_MAX_ACTIVE_SESSIONS=3
ACCESS_AUTH_TRANSACTION_TTL_MINUTES=5
ACCESS_WEBAUTHN_CHALLENGE_TTL_MINUTES=5
ACCESS_SESSION_CAPACITY_TTL_MINUTES=5
ACCESS_REAUTHORIZATION_TTL_MINUTES=5
ACCESS_OPERATIONAL_TOKEN_TTL_MINUTES=5
ACCESS_PASSWORD_RECOVERY_TTL_MINUTES=15
ACCESS_INVITATION_TTL_MINUTES=1440
ACCESS_RECOVERY_CODE_COUNT=10
ACCESS_PASSWORD_HISTORY_COUNT=5
ACCESS_INVITATION_EXCHANGE_TTL_MINUTES=10
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=3
ARGON_THREADS=2

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=misvales
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Cache
CACHE_STORE=redis
CACHE_PREFIX=misvales_local_cache_

# Sessions
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queues
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5

# Redis
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=misvales_local_

# Horizon
HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_local_horizon:
HORIZON_PATH=horizon

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_MAX_AGE=0

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@misvales.local
MAIL_FROM_NAME="${APP_NAME}"

# External object storage placeholders
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
