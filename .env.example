# Application
APP_NAME=MisVales
APP_ENV=local
AUTH_DEVELOPMENT_MFA_BYPASS=false
APP_DEBUG=true
RATELIMIT=true
BROADCAST_AUTH_RATE_LIMIT_PER_MINUTE=30
APP_URL=http://192.168.1.106:8000
FRONTEND_URL=http://192.168.1.106:4200
APP_TIMEZONE=UTC
DB_TIMEZONE=+00:00
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12
CLIENT_DATA_HMAC_KEY=

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
PERFORMANCE_LOG_LEVEL=warning
PERFORMANCE_LOG_DAYS=14

# Observabilidad operacional (deshabilitada por defecto en desarrollo local)
OBSERVABILITY_ENABLED=false
OBSERVABILITY_QUEUE_CONNECTION=redis
OBSERVABILITY_QUERY_METRICS_ENABLED=true
OBSERVABILITY_SLOW_QUERY_ENABLED=true
OBSERVABILITY_SLOW_QUERY_THRESHOLD_MS=250
OBSERVABILITY_SLOW_QUERY_CHANNEL=performance
OBSERVABILITY_EXPOSE_SERVER_TIMING=true

# MariaDB
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
DB_DATABASE=misvales
DB_USERNAME=
DB_PASSWORD=

# Optional Primary/Replica overrides (private VPC addresses)
MARIADB_PRIMARY_HOST=
MARIADB_PRIMARY_PORT=
DB_PRIMARY_USERNAME=
DB_PRIMARY_PASSWORD=
MARIADB_REPLICA_HOST=
MARIADB_REPLICA_PORT=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PRIMARY_SSL_CA=
DB_PRIMARY_SSL_CERT=
DB_PRIMARY_SSL_KEY=
DB_REPLICA_SSL_CA=
DB_REPLICA_SSL_CERT=
DB_REPLICA_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

# Broadcasting
BROADCAST_CONNECTION=reverb
BROADCAST_QUEUE=broadcasts
REVERB_APP_ID=misvales-local
REVERB_APP_KEY=misvales-local-web
REVERB_APP_SECRET=change-this-local-reverb-secret
REVERB_HOST=192.168.1.106
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=misvales-reverb-local
REVERB_ALLOWED_ORIGINS=192.168.1.106
REVERB_APP_MAX_MESSAGE_SIZE=1024
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=true

# Filesystem
FILESYSTEM_DISK=local

# Cache
CACHE_STORE=redis
CACHE_PREFIX=misvales_local_cache_

# Sessions
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queues
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5

# Redis
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_REVERB_DB=4
REDIS_PREFIX=misvales_local_

# Horizon
HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_local_horizon:
HORIZON_PATH=horizon
HORIZON_DEFAULT_MAX_PROCESSES=2
HORIZON_BROADCASTS_MAX_PROCESSES=1
HORIZON_ALLOWED_EMAILS=

# Sanctum
SANCTUM_STATEFUL_DOMAINS=192.168.1.106,192.168.1.106:4200,localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

# CORS
CORS_ALLOWED_ORIGINS=http://192.168.1.106:4200,http://localhost:4200,http://127.0.0.1:4200
CORS_MAX_AGE=0

# Google Maps Address Validation API
GOOGLE_MAPS_ADDRESS_VALIDATION_API_KEY=

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@misvales.local
MAIL_FROM_NAME="${APP_NAME}"

# External object storage placeholders
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Initial General Manager
INITIAL_MANAGER_NAME="Gerente General"
INITIAL_MANAGER_EMAIL="admin@misvales.com"
