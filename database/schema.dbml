  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'distributor_operational_blocks_id_primary', pk]
    ("distributor_id", "type", "status") [name: 'distributor_operational_blocks_distributor_id_type_status_index']
    ("type", "source_type", "source_id") [name: 'distributor_operational_blocks_type_source_type_source_id_unique', unique]
  }

  Note: 'distributor_operational_blocks_type_check: CHECK (type IN (\'DELINQUENCY\')); distributor_operational_blocks_status_check: CHECK (status IN (\'ACTIVE\', \'RELEASED\')); distributor_operational_blocks_dates_check: CHECK (ends_at IS NULL OR ends_at > starts_at)'
}

