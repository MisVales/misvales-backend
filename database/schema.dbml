Project MisVales {
  database_type: 'PostgreSQL'
  Note: 'Generado desde PostgreSQL aplicado mediante information_schema y pg_catalog.'
}

Table "account_invitations" {
  "id" uuid [not null]
  "user_id" uuid [not null]
  "created_by_user_id" uuid
  "purpose" varchar(255) [not null, default: `'ACCOUNT_ACTIVATION'::character varying`]
  "token_hash" varchar(255) [not null]
  "exchange_token_hash" varchar(255)
  "state" varchar(255) [not null, default: `'ACTIVE'::character varying`]
  "expires_at" timestamptz [not null]
  "inspected_at" timestamptz
  "prepared_at" timestamptz
  "consumed_at" timestamptz
  "revoked_at" timestamptz
  "exchange_expires_at" timestamptz
  "mfa_setup_completed_at" timestamptz
  "recovery_codes_confirmed_at" timestamptz
  "attempt_count" integer [not null, default: `0`]
  "last_attempt_at" timestamptz
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'account_invitations_pkey', pk]
    ("user_id", "purpose") [name: 'account_invitations_active_unique', unique, note: 'WHERE ((state)::text = ANY ((ARRAY[\'ACTIVE\'::character varying, \'PREPARED\'::character varying])::text[]))']
    ("exchange_token_hash") [name: 'account_invitations_exchange_token_hash_unique', unique]
    ("token_hash") [name: 'account_invitations_token_hash_unique', unique]
  }

  Note: 'chk_invitation_purpose: CHECK (purpose::text = \'ACCOUNT_ACTIVATION\'::text); chk_invitation_state: CHECK (state::text = ANY (ARRAY[\'ACTIVE\'::character varying, \'PREPARED\'::character varying, \'CONSUMED\'::character varying, \'EXPIRED\'::character varying, \'REVOKED\'::character varying]::text[]))'
}

Table "application_assets_liabilities" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "entry_type" varchar(32) [not null]
  "name" varchar(255) [not null]
  "amount" numeric(19,4)
  "outstanding_balance" numeric(19,4)
  "monthly_payment" numeric(19,4)
  "is_active" boolean [not null, default: `true`]
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_assets_liabilities_pkey', pk]
    ("application_id") [name: 'application_assets_liabilities_application_id_index']
  }

  Note: 'application_assets_amounts_check: CHECK ((amount IS NULL OR amount >= 0::numeric) AND (outstanding_balance IS NULL OR outstanding_balance >= 0::numeric) AND (monthly_payment IS NULL OR monthly_payment >= 0::numeric)); application_assets_entry_type_check: CHECK (entry_type::text = ANY (ARRAY[\'ASSET\'::character varying, \'LIABILITY\'::character varying, \'ACTIVE_COMMITMENT\'::character varying]::text[]))'
}

Table "application_authorizations" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "decision" varchar(50) [not null]
  "initial_credit_line_amount" numeric(19,4)
  "reason" text [not null]
  "authorized_by" uuid [not null]
  "authorized_at" timestamptz [not null]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_authorizations_pkey', pk]
    ("application_id") [name: 'application_authorizations_application_id_unique', unique]
  }

  Note: 'application_authorizations_amount_check: CHECK (decision::text = \'APPROVED\'::text AND initial_credit_line_amount > 0::numeric OR decision::text = \'REJECTED\'::text AND initial_credit_line_amount IS NULL); application_authorizations_decision_check: CHECK (decision::text = ANY (ARRAY[\'APPROVED\'::character varying, \'REJECTED\'::character varying]::text[]))'
}

