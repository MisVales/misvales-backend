    ("credit_line_id", "requested_at") [name: 'credit_increase_requests_credit_line_id_requested_at_index']
    ("distributor_id", "requested_at") [name: 'credit_increase_requests_distributor_id_requested_at_index']
    ("request_number") [name: 'credit_increase_requests_request_number_unique', unique]
  }

  Note: 'credit_increase_requests_amounts_check: CHECK (requested_amount > 0::numeric AND (recommended_amount IS NULL OR recommended_amount > 0::numeric) AND (authorized_amount IS NULL OR authorized_amount > 0::numeric AND authorized_amount <= requested_amount)); credit_increase_requests_lock_version_check: CHECK (lock_version >= 1); credit_increase_requests_manager_decision_check: CHECK (manager_decision IS NULL OR (manager_decision::text = ANY (ARRAY[\'APPROVE_REQUESTED\'::character varying, \'APPROVE_LOWER\'::character varying, \'REJECT\'::character varying]::text[]))); credit_increase_requests_snapshot_check: CHECK (line_total_at_request > 0::numeric AND used_balance_at_request >= 0::numeric AND used_balance_at_request <= line_total_at_request AND available_balance_at_request >= 0::numeric AND available_balance_at_request = (line_total_at_request - used_balance_at_request)); credit_increase_requests_status_check: CHECK (status::text = ANY (ARRAY[\'REQUESTED\'::character varying, \'REJECTED_BY_COORDINATOR\'::character varying, \'PREAUTHORIZED\'::character varying, \'REJECTED_BY_MANAGER\'::character varying, \'AUTHORIZED_PARTIAL\'::character varying, \'AUTHORIZED_TOTAL\'::character varying, \'COMPLETED\'::character varying]::text[]))'
}

