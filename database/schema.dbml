  "manager_reason" varchar(255)
  "restriction_id" uuid
  "completed_at" timestamptz
  "lock_version" integer [not null, default: 1]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'credit_increase_requests_id_primary', pk]
    ("request_number") [name: 'credit_increase_requests_request_number_unique', unique]
    ("distributor_id", "requested_at") [name: 'credit_increase_requests_distributor_id_requested_at_index']
    ("credit_line_id", "requested_at") [name: 'credit_increase_requests_credit_line_id_requested_at_index']
  }

  Note: 'credit_increase_requests_lock_version_check: CHECK (lock_version >= 1); credit_increase_requests_amounts_check: CHECK (requested_amount > 0 AND (recommended_amount IS NULL OR recommended_amount > 0) AND (authorized_amount IS NULL OR (authorized_amount > 0 AND authorized_amount <= requested_amount))); credit_increase_requests_snapshot_check: CHECK (line_total_at_request > 0 AND used_balance_at_request >= 0 AND used_balance_at_request <= line_total_at_request AND available_balance_at_request >= 0 AND available_balance_at_request = line_total_at_request - used_balance_at_request); credit_increase_requests_status_check: CHECK (status IN (\'REQUESTED\',\'REJECTED_BY_COORDINATOR\',\'PREAUTHORIZED\',\'REJECTED_BY_MANAGER\',\'AUTHORIZED_PARTIAL\',\'AUTHORIZED_TOTAL\',\'COMPLETED\')); credit_increase_requests_manager_decision_check: CHECK (manager_decision IS NULL OR manager_decision IN (\'APPROVE_REQUESTED\',\'APPROVE_LOWER\',\'REJECT\'))'
}

