  "recommended_amount" decimal(19,4)
  "authorized_amount" decimal(19,4)
  "line_total_at_request" decimal(19,4) [not null]
  "used_balance_at_request" decimal(19,4) [not null]
  "available_balance_at_request" decimal(19,4) [not null]
  "request_reason" varchar(255) [not null]
