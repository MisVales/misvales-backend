Table "application_residences" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "is_current" boolean [not null, default: `true`]
  "street" varchar(255) [not null]
  "exterior_number" varchar(32) [not null]
  "interior_number" varchar(32)
