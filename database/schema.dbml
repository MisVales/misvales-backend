    ("application_id") [name: 'application_residences_application_id_index']
    ("application_id") [name: 'application_residences_one_current', unique, note: 'WHERE (is_current = true)']
  }

  Note: 'application_residences_dimensions_check: CHECK ((width_meters IS NULL OR width_meters > 0::numeric) AND (length_meters IS NULL OR length_meters > 0::numeric) AND (built_area_square_meters IS NULL OR built_area_square_meters > 0::numeric)); application_residences_financing_check: CHECK (financing_status IS NULL OR (financing_status::text = ANY (ARRAY[\'PAID\'::character varying, \'MORTGAGE\'::character varying, \'LOAN\'::character varying, \'INFONAVIT\'::character varying, \'OTHER\'::character varying, \'NOT_APPLICABLE\'::character varying]::text[]))); application_residences_tenure_check: CHECK (housing_tenure::text = ANY (ARRAY[\'OWNED\'::character varying, \'RENTED\'::character varying, \'BORROWED\'::character varying, \'OTHER\'::character varying]::text[]))'
}

