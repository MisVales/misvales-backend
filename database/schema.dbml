    ("configuration_definition_id", "status") [name: 'configuration_versions_configuration_definition_id_status_index']
    ("configuration_definition_id", "effective_from", "effective_to") [name: 'configuration_versions_configuration_definition_id_effective_from_effective_to_index']
    ("status", "effective_from") [name: 'configuration_versions_status_effective_from_index']
    ("configuration_definition_id") [name: 'configuration_versions_open_published_unique', unique, note: 'WHERE status = \'PUBLISHED\' AND effective_to IS NULL;']
  }

  Note: 'chk_cv_version: CHECK (version > 0); chk_cv_effective_dates: CHECK (effective_to IS NULL OR effective_to > effective_from); chk_cv_status: CHECK (status IN (\'DRAFT\', \'PUBLISHED\', \'INACTIVE\')); chk_cv_published_consistency: CHECK ( (status = \'PUBLISHED\' AND published_by IS NOT NULL AND published_at IS NOT NULL) OR (status <> \'PUBLISHED\') ); chk_cv_lock_version: CHECK (lock_version >= 0)'
}

