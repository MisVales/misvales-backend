Project MisVales {
  database_type: 'MariaDB'
  Note: 'Esquema final consolidado estaticamente desde las migraciones Laravel actuales para MariaDB.'
}

Table "account_invitations" {
  "id" uuid [not null]
  "user_id" uuid [not null]
  "created_by_user_id" uuid
  "purpose" varchar(255) [not null, default: 'ACCOUNT_ACTIVATION']
  "token_hash" varchar(255) [not null]
  "exchange_token_hash" varchar(255)
  "state" varchar(255) [not null, default: 'ACTIVE']
  "expires_at" timestamptz [not null]
  "inspected_at" timestamptz
  "prepared_at" timestamptz
  "consumed_at" timestamptz
  "revoked_at" timestamptz
  "exchange_expires_at" timestamptz
  "mfa_setup_completed_at" timestamptz
  "recovery_codes_confirmed_at" timestamptz
  "attempt_count" integer [not null, default: 0]
  "last_attempt_at" timestamptz
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'account_invitations_id_primary', pk]
    ("token_hash") [name: 'account_invitations_token_hash_unique', unique]
    ("exchange_token_hash") [name: 'account_invitations_exchange_token_hash_unique', unique]
    ("user_id", "purpose") [name: 'account_invitations_active_unique', unique, note: 'WHERE state IN (\'ACTIVE\', \'PREPARED\')']
  }

  Note: 'chk_invitation_state: CHECK (state IN (\'ACTIVE\', \'PREPARED\', \'CONSUMED\', \'EXPIRED\', \'REVOKED\')); chk_invitation_purpose: CHECK (purpose IN (\'ACCOUNT_ACTIVATION\'))'
}

Table "application_assets_liabilities" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "entry_type" varchar(32) [not null]
  "name" varchar(255) [not null]
  "amount" decimal(19,4)
  "outstanding_balance" decimal(19,4)
  "monthly_payment" decimal(19,4)
  "is_active" boolean [not null, default: true]
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_assets_liabilities_id_primary', pk]
    ("application_id") [name: 'application_assets_liabilities_application_id_index']
  }

  Note: 'application_assets_entry_type_check: CHECK (entry_type IN (\'ASSET\', \'LIABILITY\', \'ACTIVE_COMMITMENT\')); application_assets_amounts_check: CHECK ((amount IS NULL OR amount >= 0) AND (outstanding_balance IS NULL OR outstanding_balance >= 0) AND (monthly_payment IS NULL OR monthly_payment >= 0))'
}

Table "application_authorizations" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "decision" varchar(50) [not null]
  "initial_credit_line_amount" decimal(19,4)
  "reason" text [not null]
  "authorized_by" uuid [not null]
  "authorized_at" timestamptz [not null]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_authorizations_id_primary', pk]
    ("application_id") [name: 'application_authorizations_application_id_unique', unique]
  }

  Note: 'application_authorizations_decision_check: CHECK (decision IN (\'APPROVED\',\'REJECTED\')); application_authorizations_amount_check: CHECK ((decision = \'APPROVED\' AND initial_credit_line_amount > 0) OR (decision = \'REJECTED\' AND initial_credit_line_amount IS NULL))'
}

Table "application_commercial_credits" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "company_name" varchar(255) [not null]
  "credit_limit" decimal(19,4) [not null]
  "is_current" boolean [not null, default: true]
  "proof_reference" uuid
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_commercial_credits_id_primary', pk]
    ("application_id") [name: 'application_commercial_credits_application_id_index']
  }

  Note: 'application_commercial_credits_limit_check: CHECK (credit_limit >= 0)'
}

Table "application_corrections" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "verification_visit_id" uuid [not null]
  "section" varchar(50) [not null]
  "field_path" varchar(255) [not null]
  "previous_value_payload" text [not null]
  "new_value_payload" text [not null]
  "reason" text [not null]
  "corrected_by" uuid [not null]
  "corrected_at" timestamptz [not null]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_corrections_id_primary', pk]
    ("application_id", "corrected_at") [name: 'application_corrections_application_id_corrected_at_index']
  }
}

Table "application_employments" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "employer_name" varchar(255) [not null]
  "job_title" varchar(255)
  "started_at" date
  "ended_at" date
  "is_current" boolean [not null, default: true]
  "reference_payload" jsonb
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_employments_id_primary', pk]
    ("application_id") [name: 'application_employments_application_id_index']
  }

  Note: 'application_employments_dates_check: CHECK (ended_at IS NULL OR started_at IS NULL OR ended_at >= started_at)'
}

Table "application_evaluations" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "verification_visit_id" uuid [not null]
  "result" varchar(50) [not null]
  "reason" text [not null]
  "evaluation_payload" jsonb
  "evaluated_by" uuid [not null]
  "evaluated_at" timestamptz [not null]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_evaluations_id_primary', pk]
    ("application_id", "evaluated_at") [name: 'application_evaluations_application_id_evaluated_at_index']
  }

  Note: 'application_evaluations_result_check: CHECK (result IN (\'COMPLIES\',\'DOES_NOT_COMPLY\'))'
}

Table "application_family_members" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "relationship" varchar(24) [not null]
  "first_name" varchar(255) [not null]
  "first_last_name" varchar(255) [not null]
  "second_last_name" varchar(255)
  "birth_date" date
  "declared_age" smallint
  "school_name" varchar(255)
  "is_family_reference" boolean [not null, default: false]
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_family_members_id_primary', pk]
    ("application_id") [name: 'application_family_members_application_id_index']
  }

  Note: 'application_family_relationship_check: CHECK (relationship IN (\'SPOUSE\', \'PARTNER\', \'CHILD\', \'FATHER\', \'MOTHER\', \'SIBLING\', \'OTHER\')); application_family_age_check: CHECK (declared_age IS NULL OR declared_age <= 130)'
}

Table "application_personal_data" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "first_name" varchar(255) [not null]
  "first_last_name" varchar(255) [not null]
  "second_last_name" varchar(255)
  "curp_ciphertext" text [not null]
  "curp_hmac" char(64) [not null]
  "rfc_ciphertext" text
  "rfc_hmac" char(64)
  "birth_date" date [not null]
  "birth_place" varchar(255) [not null]
  "birth_state" varchar(255) [not null]
  "birth_city" varchar(255) [not null]
  "email" varchar(255) [not null]
  "phone_number" varchar(32) [not null]
  "official_id_type" varchar(32) [not null]
  "official_id_number_ciphertext" text [not null]
  "official_id_number_hmac" char(64) [not null]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_personal_data_id_primary', pk]
    ("application_id") [name: 'application_personal_data_application_id_unique', unique]
  }

  Note: 'application_personal_data_id_type_check: CHECK (official_id_type IN (\'INE\', \'PASSPORT\', \'PROFESSIONAL_LICENSE\', \'OTHER\'))'
}

Table "application_residences" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "is_current" boolean [not null, default: true]
  "street" varchar(255) [not null]
  "exterior_number" varchar(32) [not null]
  "interior_number" varchar(32)
  "neighborhood" varchar(255) [not null]
  "postal_code" varchar(16) [not null]
  "municipality" varchar(255) [not null]
  "city" varchar(255) [not null]
  "state" varchar(255) [not null]
  "country" char(2) [not null, default: 'MX']
  "housing_tenure" varchar(24) [not null]
  "financing_status" varchar(24)
  "width_meters" decimal(10,2)
  "length_meters" decimal(10,2)
  "built_area_square_meters" decimal(12,2)
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_residences_id_primary', pk]
    ("application_id") [name: 'application_residences_application_id_index']
    ("application_id") [name: 'application_residences_one_current', unique, note: 'WHERE is_current = true']
  }

  Note: 'application_residences_tenure_check: CHECK (housing_tenure IN (\'OWNED\', \'RENTED\', \'BORROWED\', \'OTHER\')); application_residences_financing_check: CHECK (financing_status IS NULL OR financing_status IN (\'PAID\', \'MORTGAGE\', \'LOAN\', \'INFONAVIT\', \'OTHER\', \'NOT_APPLICABLE\')); application_residences_dimensions_check: CHECK ((width_meters IS NULL OR width_meters > 0) AND (length_meters IS NULL OR length_meters > 0) AND (built_area_square_meters IS NULL OR built_area_square_meters > 0))'
}

Table "application_state_transitions" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "from_status" varchar(50)
  "to_status" varchar(50) [not null]
  "user_id" uuid [note: 'Actor que realiza el cambio']
  "reason" text
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_state_transitions_id_primary', pk]
  }

  Note: 'application_state_transitions_from_status_check: CHECK (from_status IN (\'DRAFT\', \'COORDINATOR_REVIEW\', \'VERIFIER_ASSIGNED\', \'PHYSICAL_VERIFICATION\', \'COORDINATOR_CORRECTION\', \'COORDINATOR_EVALUATION\', \'MANAGER_AUTHORIZATION\', \'TERMINATED_UNFAVORABLE\', \'REJECTED\', \'AUTHORIZED_PENDING_ACTIVATION\', \'ACTIVE\')); application_state_transitions_to_status_check: CHECK (to_status IN (\'DRAFT\', \'COORDINATOR_REVIEW\', \'VERIFIER_ASSIGNED\', \'PHYSICAL_VERIFICATION\', \'COORDINATOR_CORRECTION\', \'COORDINATOR_EVALUATION\', \'MANAGER_AUTHORIZATION\', \'TERMINATED_UNFAVORABLE\', \'REJECTED\', \'AUTHORIZED_PENDING_ACTIVATION\', \'ACTIVE\'))'
}

Table "application_vehicles" {
  "id" uuid [not null]
  "application_id" uuid [not null]
  "vehicle_type" varchar(64) [not null]
  "brand" varchar(255)
  "model" varchar(255)
  "model_year" smallint
  "ownership_status" varchar(32)
  "details_payload" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'application_vehicles_id_primary', pk]
    ("application_id") [name: 'application_vehicles_application_id_index']
  }

  Note: 'application_vehicles_model_year_check: CHECK (model_year IS NULL OR model_year BETWEEN 1886 AND 2200)'
}

Table "audit_logs" {
  "id" uuid [not null]
  "actor_id" uuid
  "actor_role" varchar(255)
  "branch_id" uuid
  "entity_type" varchar(255) [not null]
  "entity_id" uuid
  "version" varchar(255)
  "previous_value" jsonb
  "new_value" jsonb
  "effective_from" timestamptz
  "effective_to" timestamptz
  "reason" text
  "ip_address" ipaddress
  "user_agent" text
  "request_id" varchar(255)
  "result" varchar(255) [not null, default: 'SUCCESS']
  "created_at" timestamptz
  "updated_at" timestamptz
  "event_name" varchar(255)
  "trace_id" varchar(255)
  "event_type" varchar(255) [note: 'GENERATED ALWAYS AS (event_name) STORED']
  "authorizer_id" uuid
  "executor_id" uuid
  "session_id" uuid
  "correlation_id" varchar(255)
  "evidence" jsonb
  "rule_snapshot" jsonb

  indexes {
    ("id") [name: 'audit_logs_id_primary', pk]
    ("actor_id") [name: 'audit_logs_actor_id_index']
    ("branch_id") [name: 'audit_logs_branch_id_index']
    ("entity_type") [name: 'audit_logs_entity_type_index']
    ("entity_id") [name: 'audit_logs_entity_id_index']
    ("request_id") [name: 'audit_logs_request_id_index']
    ("trace_id") [name: 'audit_logs_trace_id_index']
    ("event_type") [name: 'audit_logs_event_type_index']
    ("authorizer_id") [name: 'audit_logs_authorizer_id_index']
    ("executor_id") [name: 'audit_logs_executor_id_index']
    ("session_id") [name: 'audit_logs_session_id_index']
    ("correlation_id") [name: 'audit_logs_correlation_id_index']
  }
}

Table "auth_sessions" {
  "id" uuid [not null]
  "user_id" uuid [not null]
  "session_identifier_hash" varchar(255) [not null]
  "authentication_method" varchar(255)
  "mfa_method" varchar(255)
  "mfa_verified_at" timestamptz
  "ip_address" ipaddress
  "user_agent" text
  "device_name" varchar(255)
  "last_activity_at" timestamptz
  "expires_at" timestamptz [not null]
  "revoked_at" timestamptz
  "revoked_by_user_id" uuid
  "revocation_reason" varchar(255)
  "created_at" timestamptz [not null]

  indexes {
    ("id") [name: 'auth_sessions_id_primary', pk]
    ("session_identifier_hash") [name: 'auth_sessions_session_identifier_hash_unique', unique]
    ("user_id") [name: 'auth_sessions_user_id_index']
    ("expires_at") [name: 'auth_sessions_expires_at_index']
    ("revoked_at") [name: 'auth_sessions_revoked_at_index']
  }
}

Table "bank_file_imports" {
  "id" uuid [not null]
  "private_path" varchar(255) [not null]
  "file_hash" char(64) [not null]
  "uploaded_by" uuid [not null]
  "branch_id" uuid [not null]
  "status" varchar(24) [not null]
  "row_count" integer [not null, default: 0]
  "summary" jsonb
  "error" text
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'bank_file_imports_id_primary', pk]
    ("file_hash") [name: 'bank_file_imports_file_hash_unique', unique]
  }

  Note: 'bank_file_imports_status_check: CHECK (status IN (\'PROCESSED\',\'REJECTED\'))'
}

Table "bank_movements" {
  "id" uuid [not null]
  "import_id" uuid [not null]
  "row_number" integer [not null]
  "original_row" jsonb [not null]
  "payment_reference" varchar(64) [not null]
  "amount" decimal(19,4) [not null]
  "paid_at" timestamptz [not null]
  "bank_folio" varchar(100) [not null]
  "concept" text [not null]
  "classification" varchar(24) [not null]
  "relation_id" uuid
  "applied_amount" decimal(19,4) [not null, default: 0]
  "surplus_amount" decimal(19,4) [not null, default: 0]
  "errors" jsonb
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'bank_movements_id_primary', pk]
    ("bank_folio") [name: 'bank_movements_bank_folio_unique', unique]
    ("import_id", "row_number") [name: 'bank_movements_import_id_row_number_unique', unique]
  }

  Note: 'bank_movements_classification_check: CHECK (classification IN (\'PARTIAL_PAYMENT\',\'SETTLEMENT\',\'SURPLUS\',\'UNRECONCILED\',\'DUPLICATE\',\'ERROR\'))'
}

Table "branches" {
  "id" uuid [not null]
  "code" varchar(20) [not null]
  "name" varchar(150) [not null]
  "is_headquarters" boolean [not null, default: false]
  "status" varchar(20) [not null]
  "lock_version" integer [not null, default: 0]
  "created_by" uuid [not null]
  "updated_by" uuid
  "created_at" timestamptz
  "updated_at" timestamptz
  "address" varchar(500)
  "address_validation_id" varchar(255)
  "address_place_id" varchar(255)
  "address_latitude" decimal(10,7)
  "address_longitude" decimal(10,7)
  "address_validated_at" timestamptz

  indexes {
    ("id") [name: 'branches_id_primary', pk]
    ("code") [name: 'branches_code_unique', unique]
    ("status") [name: 'branches_status_index']
    ("created_at") [name: 'branches_created_at_index']
    ("is_headquarters") [name: 'branches_is_headquarters_unique', unique, note: 'WHERE is_headquarters = true;']
  }

  Note: 'branches_status_check: CHECK (status IN (\'ACTIVE\', \'INACTIVE\')); branches_lock_version_check: CHECK (lock_version >= 0)'
}

Table "cache" {
  "key" varchar(255) [not null]
  "value" mediumtext [not null]
  "expiration" biginteger [not null]

  indexes {
    ("key") [name: 'cache_key_primary', pk]
    ("expiration") [name: 'cache_expiration_index']
  }
}

Table "cache_locks" {
  "key" varchar(255) [not null]
  "owner" varchar(255) [not null]
  "expiration" biginteger [not null]

  indexes {
    ("key") [name: 'cache_locks_key_primary', pk]
    ("expiration") [name: 'cache_locks_expiration_index']
  }
}

Table "categories" {
  "id" uuid [not null]
  "code" varchar(255) [not null]
  "status" varchar(255) [not null]
  "lock_version" integer [not null, default: 0]
  "created_by" uuid [not null]
  "updated_by" uuid
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'categories_id_primary', pk]
    ("code") [name: 'categories_code_unique', unique]
  }

  Note: 'chk_cat_lock_version: CHECK (lock_version >= 0); chk_cat_status: CHECK (status IN (\'ACTIVE\', \'INACTIVE\'))'
}

Table "category_versions" {
  "id" uuid [not null]
  "category_id" uuid [not null]
  "version" integer [not null]
  "status" varchar(255) [not null]
  "effective_from" timestamptz [not null]
  "effective_to" timestamptz
  "reason" text [not null]
  "created_by" uuid [not null]
  "published_by" uuid
  "published_at" timestamptz
  "created_at" timestamptz
  "updated_at" timestamptz
  "name" varchar(255) [not null]
  "description" text
  "lock_version" integer [not null, default: 0]
  "profit_percentage" decimal(9,6) [not null]

  indexes {
    ("id") [name: 'category_versions_id_primary', pk]
    ("category_id", "version") [name: 'category_versions_category_id_version_unique', unique]
    ("category_id", "status") [name: 'category_versions_category_id_status_index']
    ("category_id", "effective_from", "effective_to") [name: 'category_versions_category_id_effective_from_effective_to_index']
    ("category_id") [name: 'category_versions_open_published_unique', unique, note: 'WHERE status = \'PUBLISHED\' AND effective_to IS NULL;']
  }

  Note: 'chk_catv_version: CHECK (version > 0); chk_catv_effective_dates: CHECK (effective_to IS NULL OR effective_to > effective_from); chk_catv_status: CHECK (status IN (\'DRAFT\', \'PUBLISHED\', \'INACTIVE\')); chk_catv_profit_percentage: CHECK (profit_percentage >= 0 AND profit_percentage <= 1)'
}

Table "client_addresses" {
  "id" uuid [not null]
  "client_id" uuid [not null]
  "is_current" boolean [not null, default: true]
  "street" varchar(255) [not null]
  "exterior_number" varchar(255) [not null]
  "interior_number" varchar(255)
  "neighborhood" varchar(255) [not null]
  "postal_code" varchar(10) [not null]
  "municipality" varchar(255) [not null]
  "city" varchar(255) [not null]
  "state" varchar(255) [not null]
  "country" char(2) [not null, default: 'MX']
  "normalized_fingerprint_hmac" char(64) [not null]
  "address_proof_media_id" uuid
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz
  "created_by" uuid [not null]
  "change_reason" varchar(255)
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'client_addresses_id_primary', pk]
    ("client_id", "starts_at") [name: 'client_addresses_client_id_starts_at_index']
    ("client_id") [name: 'client_addresses_current_client_unique', unique, note: 'WHERE ends_at IS NULL AND is_current = true']
    ("normalized_fingerprint_hmac") [name: 'client_addresses_current_fingerprint_unique', unique, note: 'WHERE ends_at IS NULL AND is_current = true']
  }

  Note: 'client_addresses_dates_check: CHECK (ends_at IS NULL OR ends_at > starts_at)'
}

Table "client_bank_accounts" {
  "id" uuid [not null]
  "client_id" uuid [not null]
  "bank_name" varchar(255) [not null]
  "account_holder_name" varchar(255) [not null]
  "account_number_ciphertext" text
  "account_number_hmac" char(64)
  "clabe_ciphertext" text [not null]
  "clabe_hmac" char(64) [not null]
  "is_current" boolean [not null, default: true]
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz
  "created_by" uuid [not null]
  "change_reason" varchar(255)
  "lock_version" integer [not null, default: 1]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'client_bank_accounts_id_primary', pk]
    ("client_id", "starts_at") [name: 'client_bank_accounts_client_id_starts_at_index']
    ("account_number_hmac") [name: 'client_bank_accounts_account_number_hmac_index']
    ("clabe_hmac") [name: 'client_bank_accounts_clabe_hmac_index']
    ("client_id") [name: 'client_bank_accounts_current_client_unique', unique, note: 'WHERE ends_at IS NULL AND is_current = true']
  }

  Note: 'client_bank_accounts_dates_check: CHECK (ends_at IS NULL OR ends_at > starts_at); client_bank_accounts_lock_version_check: CHECK (lock_version >= 1)'
}

Table "client_distributor_assignments" {
  "id" uuid [not null]
  "client_id" uuid [not null]
  "distributor_id" uuid [not null]
  "branch_id" uuid [not null]
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz
  "assigned_by" uuid [not null]
  "reason" varchar(255)
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
