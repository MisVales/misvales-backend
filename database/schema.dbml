  "reason" text [not null]
  "status" varchar(24) [not null, default: 'REQUESTED']
  "decided_by" uuid
  "decision_reason" text
  "decided_at" timestamptz
  "token_hash" varchar(64)
  "token_expires_at" timestamptz
  "token_used_at" timestamptz
  "changes_before" jsonb
  "changes_after" jsonb
  "lock_version" integer [not null, default: 1]
  "created_at" timestamptz
  "updated_at" timestamptz

  indexes {
    ("id") [name: 'voucher_modification_requests_id_primary', pk]
    ("branch_id", "status", "created_at") [name: 'voucher_modification_requests_branch_id_status_created_at_index']
    ("voucher_id", "status") [name: 'voucher_modification_requests_voucher_id_status_index']
  }

  Note: 'voucher_modification_status_check: CHECK (status IN (\'REQUESTED\', \'AUTHORIZED\', \'REJECTED\', \'APPLIED\', \'EXPIRED\')); voucher_modification_lock_check: CHECK (lock_version >= 1); voucher_modification_token_check: CHECK ((status = \'AUTHORIZED\' AND token_hash IS NOT NULL AND token_expires_at IS NOT NULL AND token_used_at IS NULL) OR status <> \'AUTHORIZED\')'
}

Table "vouchers" {
  "id" uuid [not null]
  "folio" varchar(32) [not null]
  "type" varchar(24) [not null]
  "status" varchar(32) [not null, default: 'GENERATED']
  "client_id" uuid [not null]
  "distributor_id" uuid [not null]
  "branch_id" uuid [not null]
  "credit_line_id" uuid [not null]
  "product_id" uuid [not null]
  "product_version_id" uuid [not null]
  "category_version_id" uuid [not null]
  "credit_restriction_id" uuid
  "capital" decimal(19,4) [not null]
  "loan_commission_percentage" decimal(9,6) [not null]
  "loan_commission_amount" decimal(19,4) [not null]
  "simple_interest_percentage" decimal(9,6) [not null]
  "fortnights_count" smallint [not null]
  "insurance_amount" decimal(19,4) [not null]
  "interest_total" decimal(19,4) [not null]
  "misvales_total" decimal(19,4) [not null]
  "misvales_payment_per_fortnight" decimal(19,4) [not null]
  "distributor_profit_percentage" decimal(9,6) [not null]
  "distributor_profit_total" decimal(19,4) [not null]
  "distributor_profit_per_fortnight" decimal(19,4) [not null]
  "client_payment_per_fortnight" decimal(19,4) [not null]
  "client_total" decimal(19,4) [not null]
  "financial_snapshot" jsonb [not null]
  "lock_version" integer [not null, default: 1]
  "created_by" uuid [not null]
  "generated_at" timestamptz [not null]
  "created_at" timestamptz
  "updated_at" timestamptz
  "released_by" uuid
  "released_at" timestamptz
  "cashed_by" uuid
  "cashed_at" timestamptz

  indexes {
    ("id") [name: 'vouchers_id_primary', pk]
    ("folio") [name: 'vouchers_folio_unique', unique]
    ("distributor_id", "generated_at") [name: 'vouchers_distributor_id_generated_at_index']
    ("client_id", "generated_at") [name: 'vouchers_client_id_generated_at_index']
    ("branch_id", "status") [name: 'vouchers_branch_id_status_index']
  }

  Note: 'vouchers_type_check: CHECK (type IN (\'PREVALE\', \'VALE_DIGITAL\')); vouchers_status_check: CHECK (status IN (\'GENERATED\', \'CASH_VALIDATION\', \'CORRECTION_PENDING\', \'RELEASED\', \'CASHED\', \'REJECTED\', \'CANCELLED\')); vouchers_money_check: CHECK (capital > 0 AND loan_commission_amount >= 0 AND insurance_amount >= 0 AND interest_total >= 0 AND misvales_total > 0 AND distributor_profit_total >= 0 AND client_total > 0); vouchers_rates_check: CHECK (loan_commission_percentage BETWEEN 0 AND 1 AND simple_interest_percentage BETWEEN 0 AND 1 AND distributor_profit_percentage BETWEEN 0 AND 1); vouchers_fortnights_check: CHECK (fortnights_count > 0); vouchers_lock_version_check: CHECK (lock_version >= 1)'
}

