Table "user_role_scopes" {
  "id" uuid [not null]
  "user_id" uuid [not null]
  "role_id" uuid [not null]
  "branch_id" uuid
  "assigned_by_user_id" uuid
  "assigned_at" timestamptz [not null]
  "revoked_by_user_id" uuid
  "revoked_at" timestamptz
  "revocation_reason" varchar(255)
  "scope_type" varchar(20) [not null]
  "status" varchar(20) [not null]
  "created_at" timestamptz
  "updated_at" timestamptz
  "assignment_reason" varchar(500)
  "scope_id" uuid

  indexes {
    ("id") [name: 'user_role_scopes_id_primary', pk]
    ("user_id", "status") [name: 'user_role_scopes_user_id_status_index']
    ("role_id", "status") [name: 'user_role_scopes_role_id_status_index']
    ("branch_id", "status") [name: 'user_role_scopes_branch_id_status_index']
    ("scope_type", "status") [name: 'user_role_scopes_scope_type_status_index']
    ("user_id", "role_id", "scope_type") [name: 'user_role_scopes_active_global_unique', unique, note: 'WHERE status = \'ACTIVE\' AND revoked_at IS NULL AND scope_type = \'GLOBAL\';']
    ("user_id", "role_id", "branch_id", "scope_type") [name: 'user_role_scopes_active_branch_unique', unique, note: 'WHERE status = \'ACTIVE\' AND revoked_at IS NULL AND branch_id IS NOT NULL']
    ("scope_type", "scope_id", "status") [name: 'user_role_scopes_scope_type_scope_id_status_index']
    ("user_id", "role_id", "scope_id") [name: 'user_role_scopes_active_distributor_unique', unique, note: 'WHERE status = \'ACTIVE\' AND revoked_at IS NULL AND scope_type = \'DISTRIBUTOR\'']
  }

  Note: 'chk_urs_status: CHECK (status IN (\'ACTIVE\', \'ENDED\', \'REVOKED\')); chk_valid_dates: CHECK (revoked_at IS NULL OR revoked_at > assigned_at); chk_status_consistency: CHECK ( (status = \'ACTIVE\' AND revoked_at IS NULL AND revoked_by_user_id IS NULL) OR (status IN (\'ENDED\', \'REVOKED\') AND revoked_at IS NOT NULL) ); chk_scope_type: CHECK (scope_type IN (\'GLOBAL\', \'BRANCH\', \'DISTRIBUTOR\')); chk_scope_branch_match: CHECK ( (scope_type = \'GLOBAL\' AND branch_id IS NULL AND scope_id IS NULL) OR (scope_type = \'BRANCH\' AND branch_id IS NOT NULL AND scope_id IS NULL) OR (scope_type = \'DISTRIBUTOR\' AND branch_id IS NOT NULL AND scope_id IS NOT NULL) )'
}

