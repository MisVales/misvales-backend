    ("is_headquarters") [name: 'branches_is_headquarters_unique', unique, note: 'WHERE (is_headquarters = true)']
    ("status") [name: 'branches_status_index']
  }

  Note: 'branches_lock_version_check: CHECK (lock_version >= 0); branches_status_check: CHECK (status::text = ANY (ARRAY[\'ACTIVE\'::character varying, \'INACTIVE\'::character varying]::text[]))'
}

