  "late_fee_amount" decimal(19,4)

  indexes {
    ("id") [name: 'product_versions_id_primary', pk]
    ("product_id", "version") [name: 'product_versions_product_id_version_unique', unique]
    ("product_id", "status") [name: 'product_versions_product_id_status_index']
    ("product_id", "effective_from", "effective_to") [name: 'product_versions_product_id_effective_from_effective_to_index']
    ("status", "effective_from") [name: 'product_versions_status_effective_from_index']
    ("product_id") [name: 'product_versions_open_published_unique', unique, note: 'WHERE status = \'PUBLISHED\' AND effective_to IS NULL;']
  }

  Note: 'chk_pv_version: CHECK (version > 0); chk_pv_insurance: CHECK (insurance_amount >= 0); chk_pv_effective_dates: CHECK (effective_to IS NULL OR effective_to > effective_from); chk_pv_status: CHECK (status IN (\'DRAFT\', \'PUBLISHED\', \'INACTIVE\')); chk_pv_nominal_amount: CHECK (nominal_amount > 0); chk_pv_nominal_amount_mod: CHECK (mod(nominal_amount, 100.0000) = 0); chk_pv_loan_commission: CHECK (loan_commission_percentage >= 0 AND loan_commission_percentage <= 1); chk_pv_simple_interest: CHECK (simple_interest_percentage >= 0 AND simple_interest_percentage <= 1); chk_pv_fortnights_count: CHECK (fortnights_count > 0)'
}

