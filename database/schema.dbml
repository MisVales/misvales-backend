    ("application_id", "assigned_at") [name: 'verification_visits_application_id_assigned_at_index']
  }

  Note: 'verification_visits_status_check: CHECK (status IN (\'ASSIGNED\',\'IN_PROGRESS\',\'COMPLETED\')); verification_visits_result_check: CHECK (result IS NULL OR result IN (\'FAVORABLE\',\'UNFAVORABLE\')); verification_visits_state_check: CHECK ((status = \'COMPLETED\' AND result IS NOT NULL AND completed_at IS NOT NULL) OR (status <> \'COMPLETED\' AND result IS NULL AND completed_at IS NULL))'
}

