  }

  Note: 'chk_pv_effective_dates: CHECK (effective_to IS NULL OR effective_to > effective_from); chk_pv_fortnights_count: CHECK (fortnights_count > 0); chk_pv_insurance: CHECK (insurance_amount >= 0::numeric); chk_pv_loan_commission: CHECK (loan_commission_percentage >= 0::numeric AND loan_commission_percentage <= 1::numeric); chk_pv_nominal_amount: CHECK (nominal_amount > 0::numeric); chk_pv_nominal_amount_mod: CHECK (mod(nominal_amount, 100.0000) = 0::numeric); chk_pv_simple_interest: CHECK (simple_interest_percentage >= 0::numeric AND simple_interest_percentage <= 1::numeric); chk_pv_status: CHECK (status::text = ANY (ARRAY[\'DRAFT\'::character varying, \'PUBLISHED\'::character varying, \'INACTIVE\'::character varying]::text[])); chk_pv_version: CHECK (version > 0)'
}

