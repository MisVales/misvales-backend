Table "category_versions" {
  "id" uuid [not null]
  "category_id" uuid [not null]
  "version" integer [not null]
  "profit_percentage" numeric(9,6) [not null]
  "status" varchar(255) [not null]
  "effective_from" timestamptz [not null]
  "effective_to" timestamptz
  "reason" text [not null]
  "created_by" uuid [not null]
  "published_by" uuid
  "published_at" timestamptz
  "created_at" timestamptz
  "updated_at" timestamptz
  "name" varchar(255) [not null]
  "description" text
  "lock_version" integer [not null, default: `0`]

  indexes {
    ("id") [name: 'category_versions_pkey', pk]
    ("category_id", "effective_from", "effective_to") [name: 'category_versions_category_id_effective_from_effective_to_index']
    ("category_id", "status") [name: 'category_versions_category_id_status_index']
    ("category_id", "version") [name: 'category_versions_category_id_version_unique', unique]
    ("category_id") [name: 'category_versions_open_published_unique', unique, note: 'WHERE (((status)::text = \'PUBLISHED\'::text) AND (effective_to IS NULL))']
  }

  Note: 'chk_catv_effective_dates: CHECK (effective_to IS NULL OR effective_to > effective_from); chk_catv_profit_percentage: CHECK (profit_percentage >= 0::numeric AND profit_percentage <= 1::numeric); chk_catv_status: CHECK (status::text = ANY (ARRAY[\'DRAFT\'::character varying, \'PUBLISHED\'::character varying, \'INACTIVE\'::character varying]::text[])); chk_catv_version: CHECK (version > 0)'
}

