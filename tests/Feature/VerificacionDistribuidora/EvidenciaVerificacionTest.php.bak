<?php
namespace Tests\Feature\VerificacionDistribuidora;
use App\Models\VerificationVisit;
use App\Models\MediaFile;
use App\Models\User;
use App\Enums\VerificationVisitStatus;
use Illuminate\Http\UploadedFile;
use Illuminate\Support\Facades\Storage;

class EvidenciaVerificacionTest extends Modulo5TestCase {
    public function test_evidencia_valida_mime_y_tamano() {
        $verifier = User::factory()->create();
        $visit = VerificationVisit::factory()->create(['verifier_id' => $verifier->id, 'status' => VerificationVisitStatus::IN_PROGRESS]);

        Storage::fake('private');
        $file = UploadedFile::fake()->create('invalid.txt', 10, 'text/plain');

        $response = $this->actingAsMfaUser($verifier, ['verifier'])
            ->postJson("/api/v1/verification-visits/{$visit->id}/evidences", [
                'file' => $file, 'file_type' => 'id_front', 'lock_version' => 1
            ]);

        $response->assertStatus(422)
                 ->assertJsonPath('error', 'VERIFICATION_EVIDENCE_MIME_INVALID');
    }

    public function test_descarga_autorizada_solo_para_involucrados() {
        $verifier = User::factory()->create();
        $otherUser = User::factory()->create();
        
        $visit = VerificationVisit::factory()->create(['verifier_id' => $verifier->id]);
        $media = MediaFile::factory()->create(['verification_visit_id' => $visit->id]);

        Storage::fake('private');
        Storage::disk('private')->put($media->path, 'dummy content');

        // Other user attempts to download
        $response1 = $this->actingAsMfaUser($otherUser, ['verifier'])
            ->getJson("/api/v1/verification-evidences/{$media->id}/download");
        $response1->assertStatus(403)->assertJsonPath('error', 'AUTH_SCOPE_DENIED');

        // Correct verifier attempts to download
        $response2 = $this->actingAsMfaUser($verifier, ['verifier'])
            ->get("/api/v1/verification-evidences/{$media->id}/download");
        $response2->assertStatus(200);
    }
}
