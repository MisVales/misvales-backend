<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_TIMEZONE" value="America/Monterrey"/>
        <env name="RATELIMIT" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CLIENT_DATA_HMAC_KEY" value="testing-client-hmac-key-not-for-production"/>
        <env name="DB_DATABASE" value="misvales_testing"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="INITIAL_GENERAL_MANAGER_ENABLED" value="true"/>
        <env name="INITIAL_GENERAL_MANAGER_NAME" value="Gerente General de Pruebas"/>
        <env name="INITIAL_GENERAL_MANAGER_EMAIL" value="gerente.general.testing@misvales.test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="OBSERVABILITY_ENABLED" value="true"/>
        <env name="OBSERVABILITY_QUEUE_CONNECTION" value="sync"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
