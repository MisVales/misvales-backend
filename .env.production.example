APP_NAME=MisVales
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Monterrey
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

ACCESS_TOKEN_TTL_MINUTES=10
ACCESS_ADMIN_REFRESH_TTL_MINUTES=480
ACCESS_TABLET_REFRESH_TTL_MINUTES=480
ACCESS_DISTRIBUTOR_REFRESH_TTL_MINUTES=1440
ACCESS_ADMIN_IDLE_TIMEOUT_MINUTES=15
ACCESS_TABLET_IDLE_TIMEOUT_MINUTES=15
ACCESS_DISTRIBUTOR_IDLE_TIMEOUT_MINUTES=30
ACCESS_MAX_ACTIVE_SESSIONS=3
ACCESS_AUTH_TRANSACTION_TTL_MINUTES=5
ACCESS_WEBAUTHN_CHALLENGE_TTL_MINUTES=5
ACCESS_SESSION_CAPACITY_TTL_MINUTES=5
ACCESS_REAUTHORIZATION_TTL_MINUTES=5
ACCESS_OPERATIONAL_TOKEN_TTL_MINUTES=5
ACCESS_PASSWORD_RECOVERY_TTL_MINUTES=15
ACCESS_INVITATION_TTL_MINUTES=1440
ACCESS_RECOVERY_CODE_COUNT=10
ACCESS_PASSWORD_HISTORY_COUNT=5

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

CACHE_STORE=redis

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_PREFIX=misvales_production_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5

HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_production_horizon:
HORIZON_PATH=horizon

SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE=600

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
