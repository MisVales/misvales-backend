APP_NAME=MisVales
APP_ENV=production
AUTH_DEVELOPMENT_MFA_BYPASS=false
APP_KEY=
APP_DEBUG=false
RUNTIME_LOG_LEVEL=debug
RUNTIME_LOG_DAYS=14
APP_URL=https://api.safeacces.lat
FRONTEND_URL=https://vpn.safeacces.lat
APP_TIMEZONE=America/Monterrey
DB_TIMEZONE=+00:00
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_INSTANCE_ID=
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12
CLIENT_DATA_HMAC_KEY=
RATELIMIT=true

LOG_CHANNEL=stack
LOG_STACK=stderr,daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30
PERFORMANCE_LOG_LEVEL=warning
PERFORMANCE_LOG_DAYS=30

# Persiste trazas HTTP mediante la cola Redis existente
OBSERVABILITY_ENABLED=true
OBSERVABILITY_QUEUE_CONNECTION=redis
OBSERVABILITY_QUERY_METRICS_ENABLED=true
OBSERVABILITY_SLOW_QUERY_ENABLED=true
OBSERVABILITY_SLOW_QUERY_THRESHOLD_MS=500
OBSERVABILITY_SLOW_QUERY_CHANNEL=stack
OBSERVABILITY_EXPOSE_SERVER_TIMING=false

MARIADB_HOST=
MARIADB_PORT=3306
DB_DATABASE=misvales
DB_USERNAME=
DB_PASSWORD=
MARIADB_PRIMARY_HOST=
MARIADB_PRIMARY_PORT=
DB_PRIMARY_USERNAME=
DB_PRIMARY_PASSWORD=
MARIADB_REPLICA_HOST=
MARIADB_REPLICA_PORT=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PRIMARY_SSL_CA=
DB_PRIMARY_SSL_CERT=
DB_PRIMARY_SSL_KEY=
DB_REPLICA_SSL_CA=
DB_REPLICA_SSL_CERT=
DB_REPLICA_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=misvales_production_
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache

CACHE_STORE=redis
CACHE_PREFIX=misvales_production_cache_
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.safeacces.lat
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5
HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_production_horizon:
HORIZON_PATH=horizon
HORIZON_DEFAULT_MAX_PROCESSES=10
HORIZON_ALLOWED_EMAILS=

SANCTUM_STATEFUL_DOMAINS=vpn.safeacces.lat
CORS_ALLOWED_ORIGINS=https://vpn.safeacces.lat
CORS_MAX_AGE=600
TRUSTED_PROXIES=127.0.0.1,::1
# CIDR de clientes VPN. TRUSTED_PROXIES debe contener solo las IP/CIDR reales de Nginx/LB.
VPN_NETWORKS=192.168.50.0/24
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_VERIFY_SSL=true
TURNSTILE_CA_BUNDLE=
WEBAUTHN_RP_ID=vpn.safeacces.lat
WEBAUTHN_ORIGIN=https://vpn.safeacces.lat

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@safeacces.lat
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_ADDRESS_VALIDATION_API_KEY=
INITIAL_GENERAL_MANAGER_ENABLED=false
INITIAL_GENERAL_MANAGER_NAME="Gerente General"
INITIAL_GENERAL_MANAGER_EMAIL=
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL=
