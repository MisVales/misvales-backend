APP_NAME=MisVales
APP_ENV=production
AUTH_DEVELOPMENT_MFA_BYPASS=false
APP_KEY=
APP_DEBUG=false
APP_URL=https://aberdeen-skiing-photography-alot.trycloudflare.com
FRONTEND_URL=https://aberdeen-skiing-photography-alot.trycloudflare.com
APP_TIMEZONE=America/Monterrey
DB_TIMEZONE=+00:00
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_INSTANCE_ID=
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12
CLIENT_DATA_HMAC_KEY=
RATELIMIT=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_PRIMARY_HOST=
DB_PRIMARY_PORT=63306
DB_PRIMARY_USERNAME=
DB_PRIMARY_PASSWORD=
DB_REPLICA_HOST=
DB_REPLICA_PORT=63306
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_DATABASE=misvales
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PRIMARY_SSL_CA=
DB_PRIMARY_SSL_CERT=
DB_PRIMARY_SSL_KEY=
DB_REPLICA_SSL_CA=
DB_REPLICA_SSL_CERT=
DB_REPLICA_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=misvales_production_
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache

CACHE_STORE=redis
CACHE_PREFIX=misvales_production_cache_
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5
HORIZON_REDIS_CONNECTION=queue
HORIZON_PREFIX=misvales_production_horizon:
HORIZON_PATH=horizon

SANCTUM_STATEFUL_DOMAINS=aberdeen-skiing-photography-alot.trycloudflare.com
CORS_ALLOWED_ORIGINS=https://aberdeen-skiing-photography-alot.trycloudflare.com
CORS_MAX_AGE=600
TRUSTED_PROXIES=127.0.0.1,::1
WEBAUTHN_RP_ID=aberdeen-skiing-photography-alot.trycloudflare.com
WEBAUTHN_ORIGIN=https://aberdeen-skiing-photography-alot.trycloudflare.com

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

BROADCAST_CONNECTION=log
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@safeacces.lat
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_ADDRESS_VALIDATION_API_KEY=
INITIAL_GENERAL_MANAGER_ENABLED=false
INITIAL_GENERAL_MANAGER_NAME="Gerente General"
INITIAL_GENERAL_MANAGER_EMAIL=
